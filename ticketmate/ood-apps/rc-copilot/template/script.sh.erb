#!/usr/bin/env bash
# Starts vLLM (loopback) and rc-copilot (all interfaces, so the OOD node proxy
# can reach it) inside the allocation. Must stay in the foreground: OOD treats
# this script exiting as the session ending.

set -uo pipefail

# Where the checkout is. OOD copies this template into the session's own
# directory, so it cannot find the repo from its own path; publish.sh writes
# ticketmate.env beside it (TICKETMATE_HOME=<monorepo root>).
[ -f ./ticketmate.env ] && . ./ticketmate.env
if [ -z "${TICKETMATE_HOME:-}" ]; then
  echo "ERROR: TICKETMATE_HOME is unset: publish the app with ticketmate/ood-apps/publish.sh" >&2
  exit 1
fi
TM_ROOT="${TM_ROOT:-$TICKETMATE_HOME/ticketmate}"
# The RC website knowledge graph. Unset or missing = drafts are not grounded,
# and everything else works as before.
RC_KG_ROOT="${RC_KG_ROOT:-$TICKETMATE_HOME/rc-kg}"
# Which graph: "full" (RC website + rc-docs) or "website" (RC website only).
RC_KG_VARIANT="${RC_KG_VARIANT:-full}"
# Files under template/ are rendered with a TemplateBinding, which exposes
# `context` and `session` but NOT the form attributes as bare locals. Bare
# `model` raises "undefined local variable" at staging time; only submit.yml.erb
# gets the attributes directly.
MODEL="<%= context.rc_model %>"
GPU_LAYOUT="<%= context.gpu_layout %>"

# Tensor parallelism and context length have to match what submit.yml.erb
# actually requested, or vLLM will either fail to start or silently reserve a
# KV cache it has no room for.
#
# Measured on this cluster at TP=2: weights 28.08 GiB/GPU, KV cache 41.21
# GiB/GPU giving 817,248 tokens. On one 80GB card the weights take ~56 GiB,
# leaving ~12.5 GiB -> roughly 124,000 KV tokens, which is still ~3.8x
# concurrency at a 32K context. A ticket plus prompt is a few thousand tokens.
case "$GPU_LAYOUT" in
  any)  TP=1; MAX_LEN=16384  ;;
  t4)   TP=1; MAX_LEN=16384  ;;
  1x40) TP=1; MAX_LEN=32768  ;;
  1x80) TP=1; MAX_LEN=32768  ;;
  4x)   TP=4; MAX_LEN=131072 ;;
  *)    TP=2; MAX_LEN=131072 ;;
esac

# The model choice overrides the layout: the 3B test model is single-GPU
# whatever was selected, and Air only ever runs on four.
case "$MODEL" in
  t4-7b)  TP=1; MAX_LEN=16384 ;;
  t4-14b) TP=1; MAX_LEN=8192  ;;
  qwen7b) TP=1; MAX_LEN=32768 ;;
  small) TP=1; MAX_LEN=16384  ;;
  air)   TP=4; MAX_LEN=131072 ;;
esac

# The backend is started before vLLM, so it needs the served model name up
# front. serve_glm.sh derives the same value from MODEL.
case "$MODEL" in
  flash)  SERVED_NAME_HINT="glm-4.7-flash" ;;
  air)    SERVED_NAME_HINT="glm-4.5-air" ;;
  qwen7b) SERVED_NAME_HINT="qwen2.5-7b-instruct" ;;
  qwen14b) SERVED_NAME_HINT="qwen2.5-14b-instruct" ;;
  t4-7b)  SERVED_NAME_HINT="qwen2.5-7b-instruct-awq" ;;
  t4-14b) SERVED_NAME_HINT="qwen2.5-14b-instruct-awq" ;;
  *)      SERVED_NAME_HINT="qwen2.5-3b-instruct" ;;
esac

export TP MAX_LEN
echo "=== layout=${GPU_LAYOUT} -> TP=${TP}, max_model_len=${MAX_LEN} ==="

echo "=== RC Copilot on $(hostname) (job ${SLURM_JOB_ID:-?}) ==="
nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv

# submit.yml.erb keeps V100s out with --exclude, built from sinfo. If one
# slips through anyway (a node sinfo didn't report), say so now rather than
# after vLLM fails with "no kernel image is available".
CC="$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -1 | tr -d ' ')"
if [ "$CC" = "7.0" ]; then
  echo "ERROR: landed on a V100 (sm_70); torch here has no kernels for it."
  echo "       Relaunch and pick a specific GPU type in the form."
  exit 1
fi

source "$TM_ROOT/cluster/env.sh"

VLLM_PID=""
APP_PID=""
KG_PID=""
cleanup() {
  echo "shutting down..."
  [ -n "${APP_PID:-}" ]  && kill "$APP_PID"  2>/dev/null
  [ -n "${VLLM_PID:-}" ] && kill "$VLLM_PID" 2>/dev/null
  # serve_kg.sh traps TERM and stops its Neo4j before exiting.
  [ -n "${KG_PID:-}" ]   && kill "$KG_PID"   2>/dev/null
  wait 2>/dev/null
}
trap cleanup EXIT INT TERM

# ── rc_kg, loopback only ──────────────────────────────────────────────────────
# Loads the graph snapshot from /projects into a private, node-local Neo4j and
# serves retrieval to rc-copilot. CPU only, 1-2 min to ready, so it is up
# before vLLM; until then rc-copilot drafts without grounding and says so.
KG_LOG="$(pwd)/rc_kg.log"
# rc_kg's startup checklist; rc-copilot reads it so the extension can show
# progress while the graph loads.
export RC_KG_PROGRESS_DIR="$(pwd)/rc_kg_progress"
mkdir -p -m 700 "$RC_KG_PROGRESS_DIR"
if [ -x "$RC_KG_ROOT/scripts/serve_kg.sh" ]; then
  RC_KG_PORT="${RC_KG_PORT:-$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')}"
  # Loopback is shared by every user on this node, so rc_kg gets a token too.
  export RC_KG_API_TOKEN="$(python3 -c 'import secrets; print(secrets.token_urlsafe(24))')"
  echo "=== starting rc_kg (${RC_KG_VARIANT} graph) on 127.0.0.1:${RC_KG_PORT} (log: ${KG_LOG}) ==="
  RC_KG_ROOT="$RC_KG_ROOT" "$RC_KG_ROOT/scripts/serve_kg.sh" --port "$RC_KG_PORT" --variant "$RC_KG_VARIANT" \
    > "$KG_LOG" 2>&1 &
  KG_PID=$!
  export RC_KG_URL="http://127.0.0.1:${RC_KG_PORT}"
else
  echo "=== rc_kg not found at ${RC_KG_ROOT}; drafts will not be grounded ==="
fi

# ── rc-copilot FIRST ──────────────────────────────────────────────────────────
# Order matters. OOD publishes the port and shows the session card the moment
# this script starts, and the browser extension configures itself from that
# card. If the backend only started after the model finished loading, there
# would be several minutes where OOD says "Running", the extension has saved
# the address, and every request 502s -- which reads as "the extension cannot
# connect" rather than "the model is still loading".
#
# So the backend comes up immediately. Its /api/health reports vLLM as
# unreachable until the weights are in, with a `startup` block the extension
# shows as a progress display (vLLM's loading stage, rc_kg's checklist).
# Absolute, because the script cd's into the backend before starting vLLM and
# a relative path would drop the log somewhere unhelpful.
VLLM_LOG="$(pwd)/vllm.log"
# rc-copilot reads it to report the model's loading progress (app/startup.py).
export VLLM_LOG_FILE="$VLLM_LOG"

cd "$TM_ROOT/backend" || exit 1

export VLLM_BASE_URL="http://127.0.0.1:${VLLM_PORT}/v1"
export VLLM_MODEL_NAME="$SERVED_NAME_HINT"
export AUTH_TOKEN="$password"     # from before.sh; OOD generated it
# Match the sign-in lifetime to the allocation, so the UI never claims more
# time than the job actually has left.
export SESSION_HOURS="<%= context.bc_num_hours %>"
export LOG_FILE=""                # stdout only -- nothing extra on /projects
export USE_PROXY_ENV=false
export RUN_LOG_DIR="${RUN_LOG_DIR:-/scratch/$USER/rc_copilot_runs}"

echo "=== starting rc-copilot on 0.0.0.0:${port} (before the model) ==="
"$TM_ROOT/backend/.venv/bin/python" -m uvicorn app.main:app \
  --host 0.0.0.0 --port "${port}" &
APP_PID=$!

sleep 3
kill -0 "$APP_PID" 2>/dev/null || { echo "ERROR: rc-copilot failed to start."; exit 1; }
echo "=== rc-copilot is listening; the extension can connect now ==="

# ── vLLM, loopback only ───────────────────────────────────────────────────────
echo "=== starting vLLM on 127.0.0.1:${VLLM_PORT} (model=${MODEL}) ==="
MODEL="$MODEL" PORT="$VLLM_PORT" VLLM_HOST=127.0.0.1 TP="$TP" MAX_LEN="$MAX_LEN" \
  "$TM_ROOT/cluster/serve_glm.sh" > "$VLLM_LOG" 2>&1 &
VLLM_PID=$!

echo -n "loading weights (the UI will say the model is unreachable until this finishes)"
READY=0
for _ in $(seq 1 180); do   # up to ~30 min: a first-time AWQ download is slow
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then
    wait "$VLLM_PID"; VLLM_RC=$?
    # Marks the log so the progress display says "failed" even when vLLM
    # died without a traceback (e.g. killed for memory).
    echo "rc-copilot: vLLM exited with status ${VLLM_RC}" >> "$VLLM_LOG"
    echo; echo "ERROR: vLLM exited early. Tail of vllm.log:"; tail -40 "$VLLM_LOG"
    echo "NOTE: rc-copilot is still up, so /api/health will report the model"
    echo "      as unreachable rather than the session simply vanishing."
    break
  fi
  if curl -sf --noproxy '*' --max-time 3 \
       "http://127.0.0.1:${VLLM_PORT}/v1/models" -o /dev/null; then
    READY=1; echo " ready"; break
  fi
  echo -n "."
  sleep 10
done

if [ "$READY" = 1 ]; then
  SERVED_MODEL="$(curl -sf --noproxy '*' "http://127.0.0.1:${VLLM_PORT}/v1/models" \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["data"][0]["id"])')"
  echo "=== vLLM serving ${SERVED_MODEL} ==="
  if [ "$SERVED_MODEL" != "$SERVED_NAME_HINT" ]; then
    # The backend was started with a guess at the served name. If vLLM ended up
    # advertising something else, restart the backend with the real one rather
    # than leaving /api/health reporting a model mismatch.
    echo "=== served name differs from the hint; restarting rc-copilot ==="
    kill "$APP_PID" 2>/dev/null; wait "$APP_PID" 2>/dev/null
    export VLLM_MODEL_NAME="$SERVED_MODEL"
    "$TM_ROOT/backend/.venv/bin/python" -m uvicorn app.main:app \
      --host 0.0.0.0 --port "${port}" &
    APP_PID=$!
  fi
else
  echo; echo "WARNING: vLLM never became ready. rc-copilot stays up so the"
  echo "         session and its logs remain reachable."
fi

if [ -n "$KG_PID" ]; then
  if curl -sf --noproxy '*' --max-time 3 "${RC_KG_URL}/health" | grep -q '"status":"ok"'; then
    echo "=== rc_kg ready: $(curl -sf --noproxy '*' "${RC_KG_URL}/health") ==="
  else
    echo "=== rc_kg still loading (see ${KG_LOG}); drafts are grounded as soon as it is up ==="
  fi
fi

echo "=== runs are recorded under ${RUN_LOG_DIR} ==="
wait "$APP_PID"
