# Copy to .env and edit:  cp .env.example .env
# .env is read from the directory you run uvicorn in (this backend/ directory).

# --- Model server (vLLM, OpenAI-compatible API) -----------------------------
# Must include the trailing /v1.
# On Explorer: start vLLM on a compute node, then either run this app on the
# same node or forward the port, e.g.
#   ssh -N -L 8000:d1234:8000 you@login.explorer.northeastern.edu
# ...and leave this as localhost:8000.
VLLM_BASE_URL=http://localhost:8000/v1

# Must match an id from GET <VLLM_BASE_URL>/models — usually the value you
# passed to `vllm serve`.
VLLM_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# vLLM normally needs no auth; set this only if you started the server with
# --api-key (or if you are pointing at a hosted API for local dev).
VLLM_API_KEY=

# --- Auth -------------------------------------------------------------------
# The token someone pastes once to sign in, in exchange for a signed session.
# LEAVE THIS UNSET on the cluster: the app then mints a random one per run and
# prints it to the console only. A token written into .env sits on the
# group-readable /projects filesystem, where the whole group can read it.
# Under the OOD app this is set for you, to the password OOD generated.
# AUTH_TOKEN=

# How long a sign-in lasts. Sized to a typical RC session/tunnel lifetime.
SESSION_HOURS=3.0

# Only for a loopback-only run on your own machine. On a shared node this
# leaves the app, and every draft, open to anyone who can reach the port.
AUTH_DISABLED=false

# --- RC knowledge graph (rc-kg) ---------------------------------------------
# Unset = drafts are not grounded in the RC website. The OOD app and
# serve_stack.sbatch start rc-kg in the same job and set both of these.
# RC_KG_URL=http://127.0.0.1:8090
# RC_KG_API_TOKEN=
RC_KG_K=6

# --- App --------------------------------------------------------------------
APP_PORT=8080

# Generation settings. Keep the temperature low so the JSON stays well-formed.
TEMPERATURE=0.2
MAX_TOKENS=1400
REQUEST_TIMEOUT_SECONDS=120

# DEBUG=true logs FULL ticket text and model output. Ticket text can contain
# researcher PII — leave this false anywhere other than your own machine.
DEBUG=false

# Relative paths resolve against the directory you launch uvicorn from.
# Set to an empty value to log to stdout only.
LOG_FILE=logs/rc_copilot.log

# Where every drafting run is recorded, one JSON file per request, so a draft
# that landed in a ticket can be explained afterwards. Read straight from the
# environment by app/runlog.py, not through Settings. Unset means
# /scratch/$USER/rc_copilot_runs; set it to the empty string to turn recording
# off entirely. The subtree is forced to 0700 and files to 0600 -- /scratch is
# group-accessible and ticket text can contain researcher PII.
# RUN_LOG_DIR=

# Count prompt tokens per part (system / ticket / sources / instructions)
# with vLLM's /tokenize, for the run log's token breakdown.
TRACE_TOKEN_BREAKDOWN=true

# The serving model grades each draft in the background (one extra call per
# draft); lower the sample rate to grade only some.
ONLINE_EVAL=true
ONLINE_EVAL_SAMPLE_RATE=1.0

# Route model-server calls through HTTP_PROXY/HTTPS_PROXY. Leave false for
# an on-cluster or tunnelled vLLM; set true only if a proxy is genuinely needed
# to reach the endpoint.
USE_PROXY_ENV=false
