# Copy to .env. scripts/start_neo4j.sh writes the NEO4J_* lines for you and
# leaves everything else alone, so you only edit the provider settings here.

# --- Source site -------------------------------------------------------------
# Only this host is ingested. Links anywhere else (rc-docs.northeastern.edu,
# docs.aicr.ai, bit.ly, ...) become ExternalLink nodes and are never fetched.
SITE_BASE=https://rc.northeastern.edu
WP_API=https://rc.northeastern.edu/wp-json/wp/v2
SITEMAP_INDEX=https://rc.northeastern.edu/wp-sitemap.xml

# Sent on every request so the site's admins can identify and contact us.
USER_AGENT=RC-KG/0.1 (+Northeastern Research Computing; murugan.g@northeastern.edu)
REQUEST_DELAY=1.0
REQUEST_TIMEOUT=30.0

# --- Neo4j (written by scripts/start_neo4j.sh) -------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Embeddings --------------------------------------------------------------
# sentence_transformers | openai | vllm
# EMBEDDING_DIM must match the model, and must match the vector index. Changing
# it requires dropping and recreating section_embeddings.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
# EMBEDDING_API_KEY=

# --- LLM ---------------------------------------------------------------------
# openai_compatible covers vLLM, Ollama, llama.cpp and the OpenAI API itself.
LLM_PROVIDER=openai_compatible
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200

# --- Behaviour ---------------------------------------------------------------
# Past events go stale. False keeps calendar_event in the graph (so sections can
# still link to them) but out of retrieval results.
INCLUDE_EVENTS_IN_RETRIEVAL=false

# Follow 301s on internal body links before storing them. Measured on this site:
# a third of internal hrefs are redirects, so turning this off loses ~30 of 90
# LINKS_TO targets.
RESOLVE_REDIRECTS=true
